<Project Sdk="Microsoft.NET.Sdk">

  <!-- Carpeta de AutoCAD/Civil 3D con las DLL de referencia: la PRIMERA instalada
       (2025, 2026, 2027). Quien tenga la 2025 compila igual que siempre; en un equipo
       con otra versión se usa esa. Se puede forzar: dotnet build -p:AcadDir="…" -->
  <PropertyGroup>
    <AcadDir Condition="'$(AcadDir)' == '' And Exists('C:\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2025</AcadDir>
    <AcadDir Condition="'$(AcadDir)' == '' And Exists('C:\Program Files\Autodesk\AutoCAD 2026\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2026</AcadDir>
    <AcadDir Condition="'$(AcadDir)' == '' And Exists('C:\Program Files\Autodesk\AutoCAD 2027\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2027</AcadDir>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AcadDir>
    <!-- Civil 3D / AutoCAD 2025 y 2026 corren sobre .NET 8; la 2027, sobre .NET 10.
         El DLL sirve SOLO para la versión con la que se compiló. -->
    <AcadTfm>net8.0-windows</AcadTfm>
    <AcadTfm Condition="$(AcadDir.Contains('2027'))">net10.0-windows</AcadTfm>
  </PropertyGroup>

  <PropertyGroup>
    <!-- proceso x64; el .NET lo decide la versión de AutoCAD (arriba) -->
    <TargetFramework>$(AcadTfm)</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>proyecto1</RootNamespace>
    <AssemblyName>proyecto1</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Habilita WPF (para la ventana/panel PaletteSet) -->
    <UseWPF>true</UseWPF>
    <!-- Copiar dependencias NuGet a bin (Sqlite etc.); las DLL de Autodesk
         no se copian gracias a Private=false en cada Reference -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccPressurePipesMgd">
      <HintPath>$(AcadDir)\C3D\AeccPressurePipesMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecPropDataMgd">
      <HintPath>$(AcadDir)\ACA\AecPropDataMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
