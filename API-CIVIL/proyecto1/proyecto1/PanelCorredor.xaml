<UserControl x:Class="Civil3DBasico.PanelCorredor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ===== Paleta (índigo / violeta / naranja: obra lineal) ===== -->
        <Color x:Key="cIndigo">#FF4C6EF5</Color>
        <Color x:Key="cViol">#FF8B5CF6</Color>
        <Color x:Key="cNaranja">#FFE8590C</Color>

        <SolidColorBrush x:Key="brFondo"      Color="#FF14162B"/>
        <SolidColorBrush x:Key="brTarjeta"    Color="#FF232544"/>
        <SolidColorBrush x:Key="brIndigo"     Color="{StaticResource cIndigo}"/>
        <SolidColorBrush x:Key="brViol"       Color="{StaticResource cViol}"/>
        <SolidColorBrush x:Key="brNaranja"    Color="{StaticResource cNaranja}"/>
        <SolidColorBrush x:Key="brTexto"      Color="#FFEDEFFB"/>
        <SolidColorBrush x:Key="brTextoTenue" Color="#FF9AA0C7"/>

        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource brIndigo}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fondo" CornerRadius="7" Background="{TemplateBinding Background}"/>
                            <Border x:Name="overlay" CornerRadius="7" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Opacity" Value="0.30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource brTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource brTarjeta}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource brFondo}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
            <StackPanel>

                <!-- Cabecera -->
                <StackPanel Margin="2,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛣️" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Corredores" Foreground="{StaticResource brTexto}"
                                   FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Obra lineal: eje · rasante · sección · targets"
                               Foreground="{StaticResource brTextoTenue}" FontSize="11" Margin="0,3,0,0"/>
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource cIndigo}" Offset="0"/>
                                <GradientStop Color="{StaticResource cViol}" Offset="0.6"/>
                                <GradientStop Color="{StaticResource cNaranja}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- 1) PERFILES (paso previo) -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="① PERFILES (paso previo)"/>
                        <Button x:Name="btnProfTerreno" Style="{StaticResource Boton}" Background="{StaticResource brIndigo}"
                                Content="⛰️  Perfil de terreno (desde superficie)"/>
                        <Button x:Name="btnVista"       Style="{StaticResource Boton}" Background="{StaticResource brIndigo}"
                                Content="🖼️  Crear vista de perfil"/>
                        <Button x:Name="btnRasante"     Style="{StaticResource Boton}" Background="{StaticResource brIndigo}"
                                Content="📈  Dibujar rasante en la vista"/>
                    </StackPanel>
                </Border>

                <!-- 2) CREAR CORREDOR -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="② CREAR CORREDOR"/>
                        <Button x:Name="btnFacil"    Style="{StaticResource Boton}" Background="{StaticResource brViol}"
                                Content="⭐  Corredor FÁCIL (+ targets)"/>
                        <Button x:Name="btnTramos"   Style="{StaticResource Boton}" Background="{StaticResource brViol}"
                                Content="📐  Corredor por TRAMOS (esquinas 90°)"/>
                        <Button x:Name="btnRegiones" Style="{StaticResource Boton}" Background="{StaticResource brViol}"
                                Content="📏  Corredor por REGIONES"/>
                    </StackPanel>
                </Border>

                <!-- 3) TARGETS Y SALIDA -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="③ TARGETS Y SALIDA"/>
                        <Button x:Name="btnTargets"  Style="{StaticResource Boton}" Background="{StaticResource brNaranja}"
                                Content="🎯  Asignar targets a un corredor"/>
                        <Button x:Name="btnSupCor"   Style="{StaticResource Boton}" Background="{StaticResource brNaranja}"
                                Content="🗺️  Crear superficie del corredor"/>
                        <Button x:Name="btnSolidos"  Style="{StaticResource Boton}" Background="{StaticResource brNaranja}"
                                Content="🧊  Extraer sólidos 3D"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Cada botón lanza su comando en el dibujo activo."
                           Foreground="{StaticResource brTextoTenue}" FontSize="10.5"
                           TextAlignment="Center" Margin="0,2,0,4"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
