<UserControl x:Class="Civil3DBasico.PanelPipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Color x:Key="cAzul">#FF1F6FEB</Color>
        <Color x:Key="cAgua">#FF0E9AA0</Color>
        <Color x:Key="cAmbar">#FFE08A1E</Color>
        <Color x:Key="cVerde">#FF2FA968</Color>

        <SolidColorBrush x:Key="brFondo"      Color="#FF0F1821"/>
        <SolidColorBrush x:Key="brTarjeta"    Color="#FF182433"/>
        <SolidColorBrush x:Key="brBorde"      Color="#FF243344"/>
        <SolidColorBrush x:Key="brAzul"       Color="{StaticResource cAzul}"/>
        <SolidColorBrush x:Key="brAgua"       Color="{StaticResource cAgua}"/>
        <SolidColorBrush x:Key="brAmbar"      Color="{StaticResource cAmbar}"/>
        <SolidColorBrush x:Key="brVerde"      Color="{StaticResource cVerde}"/>
        <SolidColorBrush x:Key="brTexto"      Color="#FFEAF2FB"/>
        <SolidColorBrush x:Key="brTextoTenue" Color="#FF8FA6BF"/>

        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource brAzul}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fondo" CornerRadius="8" Background="{TemplateBinding Background}"/>
                            <Border x:Name="overlay" CornerRadius="8" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="13,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Opacity" Value="0.28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource brTarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource brBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource brFondo}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
            <StackPanel>

                <!-- Cabecera -->
                <StackPanel Margin="2,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="23" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Redes de Tuberías" Foreground="{StaticResource brTexto}"
                                   FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Gravedad y presión · Civil 3D"
                               Foreground="{StaticResource brTextoTenue}" FontSize="11" Margin="0,3,0,0"/>
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource cVerde}" Offset="0"/>
                                <GradientStop Color="{StaticResource cAzul}"  Offset="0.4"/>
                                <GradientStop Color="{StaticResource cAgua}"  Offset="0.7"/>
                                <GradientStop Color="{StaticResource cAmbar}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- PREPARAR FAMILIAS PERSONALIZADAS PARA DIBUJAR -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brAmbar}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="FAMILIAS PERSONALIZADAS" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Regenera el catálogo y añade familias a la lista de piezas" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnPrepararFamilias" Style="{StaticResource Boton}" Background="{StaticResource brAmbar}"
                                Content="⚙️  Preparar familias para dibujar"/>
                    </StackPanel>
                </Border>

                <!-- IMPORTAR RED -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brVerde}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="IMPORTAR RED" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Lee polilíneas con XDATA (pdf-to-cad)" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnImportar" Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="📥  Importar red desde DXF" Height="42" FontSize="13.5"/>
                    </StackPanel>
                </Border>

                <!-- PROPERTY SETS DE TUBERÍAS -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brAzul}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="PROPERTY SETS" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Excel intermedio para asignar datos a cada tubería" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnExportarPS" Style="{StaticResource Boton}" Background="{StaticResource brAzul}"
                                Content="📤  Exportar tuberías a Excel"/>
                        <Button x:Name="btnImportarPS" Style="{StaticResource Boton}" Background="{StaticResource brAzul}"
                                Content="📥  Importar Property Sets desde Excel"/>
                    </StackPanel>
                </Border>

                <!-- ANOTACIONES: cotas de rasante en cada nodo + cuadro resumen de buzones -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brAgua}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="ANOTACIONES" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Etiquetas de tubería/buzón, sentido de flujo y cuadro resumen" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnCotarTuberias" Style="{StaticResource Boton}" Background="{StaticResource brAgua}"
                                Content="🏷️  Agregar etiquetas"/>
                        <Button x:Name="btnCuadroBuzones" Style="{StaticResource Boton}" Background="{StaticResource brAgua}"
                                Content="🗒️  Generar cuadros resumen"/>
                    </StackPanel>
                </Border>

                <!-- PERFIL LONGITUDINAL: vista de perfil con rasante, buzones y cotas -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brVerde}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="PERFIL LONGITUDINAL" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Rasante, buzones y cotas máx/mín de una red de gravedad" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnPerfilLongitudinal" Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="📈  Generar perfil longitudinal"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
