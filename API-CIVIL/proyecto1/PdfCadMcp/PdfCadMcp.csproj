<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host MCP (stdio JSON-RPC) de PDF-a-CAD: lo lanza el cliente (Claude Code / Desktop o la app
       Python con Qwen) y reenvía cada herramienta al plugin de Civil 3D por la tubería con nombre.
       SIN referencias Autodesk: comparte solo los CONTRATOS del plugin (mismos archivos). Fuera de
       proyecto1/ para que el glob del plugin no lo compile. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PdfCadMcp</AssemblyName>
    <RootNamespace>PdfCadMcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- En el instalador va junto a la app; corre con el .NET que traiga Civil 3D (8 en 2025/2026, 10 en 2027). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\proyecto1\Mcp\Contratos\McpProtocolo.cs" Link="Contratos\McpProtocolo.cs" />
    <Compile Include="..\proyecto1\Mcp\Contratos\Herramientas\*.cs" LinkBase="Contratos\Herramientas" />
  </ItemGroup>
</Project>
