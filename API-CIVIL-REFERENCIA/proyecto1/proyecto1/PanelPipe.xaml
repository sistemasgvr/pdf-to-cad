<UserControl x:Class="Civil3DBasico.PanelPipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Color x:Key="cVerde">#FF2FA968</Color>
        <Color x:Key="cTeal">#FF0E9AA0</Color>
        <Color x:Key="cTierra">#FFC1802E</Color>

        <SolidColorBrush x:Key="brFondo"      Color="#FF0E1D17"/>
        <SolidColorBrush x:Key="brTarjeta"    Color="#FF17281F"/>
        <SolidColorBrush x:Key="brBorde"      Color="#FF24382D"/>
        <SolidColorBrush x:Key="brVerde"      Color="{StaticResource cVerde}"/>
        <SolidColorBrush x:Key="brTeal"       Color="{StaticResource cTeal}"/>
        <SolidColorBrush x:Key="brTierra"     Color="{StaticResource cTierra}"/>
        <SolidColorBrush x:Key="brTexto"      Color="#FFEAF6EF"/>
        <SolidColorBrush x:Key="brTextoTenue" Color="#FF8FB3A5"/>

        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource brVerde}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fondo" CornerRadius="8" Background="{TemplateBinding Background}"/>
                            <Border x:Name="ov" CornerRadius="8" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="13,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Opacity" Value="0.15"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ov" Property="Opacity" Value="0.28"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource brTarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource brBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource brFondo}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
            <StackPanel>

                <!-- Cabecera -->
                <StackPanel Margin="2,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚰" FontSize="23" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Red de Gravedad" Foreground="{StaticResource brTexto}"
                                   FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Alcantarillado y drenaje · Pipe Network"
                               Foreground="{StaticResource brTextoTenue}" FontSize="11" Margin="0,3,0,0"/>
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource cVerde}" Offset="0"/>
                                <GradientStop Color="{StaticResource cTeal}" Offset="0.55"/>
                                <GradientStop Color="{StaticResource cTierra}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- 1) PREPARAR -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brVerde}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="1 · PREPARAR" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Red vacía y catálogo (Parts List)" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnCrearRed" Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="🌐  Crear red vacía"/>
                        <Button x:Name="btnListaPz"  Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="📋  Listar piezas del catálogo"/>
                        <Button x:Name="btnFamilia"  Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="➕  Agregar familia (+ tamaños)"/>
                        <Button x:Name="btnTamanos"  Style="{StaticResource Boton}" Background="{StaticResource brVerde}"
                                Content="📐  Agregar diámetros a una familia"/>
                    </StackPanel>
                </Border>

                <!-- 2) TRAZAR Y COLOCAR -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brTeal}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="2 · TRAZAR Y COLOCAR" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Crea red + eje; elige buzón y tubería" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnPoli"     Style="{StaticResource Boton}" Background="{StaticResource brTeal}"
                                Content="✏️  Crear red desde POLILÍNEA (2D/3D)"/>
                        <Button x:Name="btnCogo"     Style="{StaticResource Boton}" Background="{StaticResource brTeal}"
                                Content="📍  Crear red desde COGOPOINTS"/>
                        <Button x:Name="btnUnir"     Style="{StaticResource Boton}" Background="{StaticResource brTeal}"
                                Content="🔗  Unir 2 tuberías (con buzón)"/>
                        <Button x:Name="btnPerfil"   Style="{StaticResource Boton}" Background="{StaticResource brTeal}"
                                Content="📉  Crear perfil de la red"/>
                        <Button x:Name="btnInvEje"   Style="{StaticResource Boton}" Background="{StaticResource brTeal}"
                                Content="🔄  Invertir dirección del eje"/>

                        <TextBlock Text="Desde CSV (por verificar):" Foreground="{StaticResource brTextoTenue}"
                                   FontSize="10.5" Margin="2,10,0,2"/>
                        <Button x:Name="btnCsv"      Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="📄  Desde CSV simple ⚠"/>
                        <Button x:Name="btnCompleta" Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="🗂️  Desde 2 CSV completa ⚠"/>
                    </StackPanel>
                </Border>

                <!-- 3) ANALIZAR Y EXPORTAR -->
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource brTierra}" Margin="0,1,9,1"/>
                            <StackPanel>
                                <TextBlock Text="3 · ANALIZAR Y EXPORTAR" Foreground="{StaticResource brTexto}" FontSize="12.5" FontWeight="Bold"/>
                                <TextBlock Text="Revisar, sólidos y datos" Foreground="{StaticResource brTextoTenue}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnDiag"    Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="🔎  Diagnosticar red (avisos)"/>
                        <Button x:Name="btnSolidos" Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="🧊  Extraer sólidos 3D"/>
                        <Button x:Name="btnExcel"   Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="📊  Exportar datos a Excel (CSV)"/>
                        <Button x:Name="btnPropSet" Style="{StaticResource Boton}" Background="{StaticResource brTierra}"
                                Content="🏷️  Adjuntar Property Set (ventana)"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="⚠ = pendiente de verificar.  Cada botón lanza su comando en el dibujo activo."
                           Foreground="{StaticResource brTextoTenue}" FontSize="10.5"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,4"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
